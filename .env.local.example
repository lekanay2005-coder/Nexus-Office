# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (v1 MVP uses server-side keys; v2 Model Router lets users
# supply their own per-provider keys via the settings panel / api_keys table)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Codebuff agent runtime (https://www.codebuff.com/api-keys). When a role is
# routed to the "codebuff" provider in the Model Router, roles run as real
# Codebuff agents (tool use, structured outputs) instead of single LLM calls.
# Users can also save their own key in Model Router settings.
CODEBUFF_API_KEY=

# Required for the Model Router's per-user API key storage (encrypts
# api_keys.encrypted_key at rest). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_ENCRYPTION_KEY=

# Dev/test escape hatches — skip real provider calls entirely.
NEXUS_MOCK_LLM=
NEXUS_MOCK_DEPLOY=

# Addendum 10: where /feedback submissions are emailed.
FEEDBACK_EMAIL=feedback@nexusoffice.dev
RESEND_API_KEY=
