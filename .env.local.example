# =============================================================================
# Nexus Office — complete environment template (Addendum 17 audit).
# Copy to .env.local (web app) and fill in. Every var referenced in code is
# listed here; anything you leave blank degrades gracefully unless noted.
# =============================================================================

# --- Supabase (required) -----------------------------------------------------
# From supabase.com → your project → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: listed for completeness only — NOT referenced by any app
# code today (RLS + anon key are used everywhere). Leave blank unless you add
# server-side admin code, and NEVER expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (server-only) ---------------------------------------------
# At least one is needed for real pipeline runs. The default provider is
# Google/Gemini (DEFAULT_PROVIDER_CONFIG in src/lib/providers/index.ts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Gemini (Google AI Studio) — GOOGLE_API_KEY is still honored as a fallback name.
GEMINI_API_KEY=
# Grok (xAI) via the generic OpenAI-compatible integrations connector.
XAI_API_KEY=
# OpenRouter — one key, many providers (added as a project Integration).
OPENROUTER_API_KEY=

# --- Codebuff agent runtime (server-only) ------------------------------------
# https://www.codebuff.com/api-keys — used when a role is routed to the
# "codebuff" provider in the Model Router. Users can also save their own key
# in Model Router settings (user keys win over this server key).
CODEBUFF_API_KEY=

# --- Secrets / crypto (server-only) ------------------------------------------
# Required for storing user API keys and secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_ENCRYPTION_KEY=

# --- Free-tier shared AI (server-only, all optional) --------------------------
# Used for roles on projects with no integration of their own.
NEXUS_DEFAULT_AI_PROVIDER=google
NEXUS_DEFAULT_AI_MODEL=gemini-2.0-flash-lite
NEXUS_DEFAULT_AI_KEY=
# Free-tier monthly pipeline-run cap when on the shared key.
NEXUS_FREE_MONTHLY_RUNS=50
# Global daily cap across ALL free users on the shared key (abuse protection).
NEXUS_SHARED_DAILY_CAP=500

# --- Email (optional) ----------------------------------------------------------
# Where /feedback submissions are emailed (Addendum 10). RESEND_API_KEY
# required for actual delivery; without it feedback is still recorded.
FEEDBACK_EMAIL=feedback@nexusoffice.dev
RESEND_API_KEY=

# --- Dev/test escape hatches ---------------------------------------------------
# NEXUS_MOCK_LLM=1 runs the pipeline against canned role responses (no AI
# keys needed). NEXUS_MOCK_DEPLOY=1 exercises Deploy Desk without GitHub/Vercel.
NEXUS_MOCK_LLM=
NEXUS_MOCK_DEPLOY=

# --- Client-visible app URL (optional) -----------------------------------------
# Public base URL used by branding/deep links. Client-safe (NEXT_PUBLIC_).
NEXT_PUBLIC_NEXUS_URL=

# --- CLI (apps/cli — set in the user's shell, NOT on the server) ---------------
# NEXUS_BASE_URL overrides which web app `nexus` talks to
# (default http://localhost:3000). Credentials live in ~/.nexus/config.
