# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (v1 MVP uses server-side keys; v2 Model Router lets users
# supply their own per-provider keys via the settings panel / api_keys table)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Codebuff agent runtime (https://www.codebuff.com/api-keys). When a role is
# routed to the "codebuff" provider in the Model Router, roles run as real
# Codebuff agents (tool use, structured outputs) instead of single LLM calls.
# Users can also save their own key in Model Router settings.
CODEBUFF_API_KEY=

# Required for the Model Router's per-user API key storage (encrypts
# api_keys.encrypted_key at rest). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXUS_ENCRYPTION_KEY=

# Dev/test escape hatches — skip real provider calls entirely.
NEXUS_MOCK_LLM=
NEXUS_MOCK_DEPLOY=

# Addendum 10: where /feedback submissions are emailed.
FEEDBACK_EMAIL=feedback@nexusoffice.dev
RESEND_API_KEY=

# Gemini (Google AI Studio) — GOOGLE_API_KEY is still honored as a fallback name
GEMINI_API_KEY=
# Grok (xAI) via the generic OpenAI-compatible integrations connector
XAI_API_KEY=
# OpenRouter — one key, many providers (added as a project Integration)
OPENROUTER_API_KEY=
# Shared free-tier model keys (Phase 3): used for roles on projects with no
# integration of their own. NEVER exposed to the client.
NEXUS_DEFAULT_AI_PROVIDER=google
NEXUS_DEFAULT_AI_MODEL=gemini-2.0-flash-lite
NEXUS_DEFAULT_AI_KEY=
# Free-tier monthly pipeline-run cap when on the shared key
NEXUS_FREE_MONTHLY_RUNS=50
# Global daily cap across ALL free users on the shared key (abuse protection)
NEXUS_SHARED_DAILY_CAP=500
